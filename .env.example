# JobPilot AI - Environment Configuration

# Application
APP_NAME=JobPilot AI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# HTTP API: set token and API_AUTH_REQUIRED=true before exposing the API on a network
# API_AUTH_TOKEN=generate-a-long-random-secret
# API_AUTH_REQUIRED=false
# API_LIST_LIMIT_MAX=200
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_REQUESTS=120
# API_RATE_LIMIT_WINDOW_SECONDS=60
# API_RATE_LIMIT_FAIL_OPEN=true

# Database
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_secret@127.0.0.1:5434/jobpilot_ai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Qdrant Vector Memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=jobpilot_ai

# LLM: OpenAI for proposals/chat/edits; Ollama Nano for routine, GPT-OSS for scoring
# Embeddings (Qdrant) — independent from LLM_PROVIDER; requires OPENAI_API_KEY when EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LEARNING_MIN_OUTCOMES=10
# Skip real Kwork send/inbox API (still updates DB and send_attempts). Keep true until live signoff.
PLATFORM_DRY_RUN=true
JOB_MAX_AGE_HOURS=168
JOB_SKIP_EXPIRED_DEADLINES=true
LLM_PROVIDER=openai
LLM_SIMPLE_PROVIDER=ollama
# OpenRouter: set LLM_SIMPLE_PROVIDER=openrouter to try free routine tasks.
# Create a key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SIMPLE_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_FALLBACK_TO_OLLAMA=true
# OPENROUTER_PROXY_LIST=/app/proxy-lists/proxies_poland.txt
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_SIMPLE_MODEL=gpt-4.1-nano
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
# OpenAI balance & spend monitoring
# Admin key (Organization Owner): platform.openai.com → Settings → Admin keys
# OPENAI_ADMIN_API_KEY=sk-admin-...
# Session token: platform.openai.com → F12 → Network → любой запрос → Authorization: Bearer sess-...
# OPENAI_SESSION_TOKEN=sess-...
# Optional manual prepaid balance for estimated remaining (budget - month spend)
# OPENAI_BUDGET_USD=50
# OPENAI_BALANCE_WARN_USD=5
# OPENAI_BALANCE_CRITICAL_USD=2
# OPENAI_USAGE_CACHE_SECONDS=300
# OPENAI_USAGE_ALERT_COOLDOWN_SECONDS=3600
# OPENAI_COST_LOOKBACK_DAYS=30
# Ollama Cloud — https://github.com/ollama/ollama-python
# Ключ: https://ollama.com/settings/keys
# Список моделей: curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=nemotron-3-nano:30b
OLLAMA_TIMEOUT_SECONDS=120
# Usage limits (optional): browser cookies from ollama.com/settings → DevTools → Cookies
# OLLAMA_SESSION_COOKIE=your-__Secure-session-value
# OLLAMA_AID=your-aid-value
# OLLAMA_CF_CLEARANCE=optional-cloudflare-cookie
# OLLAMA_USAGE_WARN_PERCENT=85
# OLLAMA_USAGE_CRITICAL_PERCENT=95
# OLLAMA_USAGE_CACHE_SECONDS=60
# OLLAMA_USAGE_ALERT_COOLDOWN_SECONDS=3600
# OLLAMA_AUTO_FALLBACK=true
# --- Proxy ---
# PROXY_ENABLED=false — direct connection for Kwork, Telegram, OpenAI
# PROXY_ENABLED=true + lists — rotate residential proxies from files
# PROXY_ENABLED=true + PROXY=... — single local proxy (ClashX / v2raytun / HAPP)
PROXY_ENABLED=true
# PROXY=http://host.docker.internal:7890      # ClashX / Clash Verge (HTTP mixed port)
# PROXY=socks5://host.docker.internal:10808   # v2raytun / HAPP
# Прокси для Ollama Cloud (если пусто — используется OPENAI_PROXY_LIST)
# OLLAMA_PROXY_LIST=/app/proxy-lists/proxies_poland.txt
# Proxy lists — paths inside Docker container
OPENAI_PROXY_LIST=/app/proxy-lists/proxies_poland.txt
TELEGRAM_PROXY_LIST=/app/proxy-lists/proxies_belarus.txt
PROXY_ROTATE=true
PROXY_ROTATE_MODE=sequential
PROXY_MAX_ATTEMPTS=5
PROXY_STATE_DIR=/app/data
# Optional single proxy override (overrides lists when set):
# PROXY=http://host.docker.internal:7890
# PROXY=socks5://host.docker.internal:10808
# PROXY=http://user:pass@host:port
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Cursor SDK (https://cursor.com/docs/sdk/python) — use composer-2.5, not *-fast
CURSOR_API_KEY=your-cursor-api-key
CURSOR_MODEL=composer-2.5
# Host path to project (agent edits files here via bridge)
CURSOR_WORKSPACE=/home/you/jobpilot-ai
CURSOR_WORKSPACE_HOST=
# Dev agent via Telegram (/dev)
TELEGRAM_DEV_AGENT_ENABLED=true
# CURSOR_AGENT_TIMEOUT_SECONDS=600
# CURSOR_BRIDGE_PORT=9247
# Auto-generated by scripts/docker-up.sh → data/cursor_bridge.env (do not edit manually)
# CURSOR_BRIDGE_BASE_URL=http://host.docker.internal:9247
# CURSOR_BRIDGE_AUTH_TOKEN=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id
# Your Telegram user id (from @userinfobot) — required for callbacks in shared chats
# TELEGRAM_ADMIN_USER_ID=123456789
# NOTIFICATION_OUTBOX_MAX_ATTEMPTS=8
# NOTIFICATION_OUTBOX_LEASE_SECONDS=120
# NOTIFICATION_OUTBOX_BASE_BACKOFF_SECONDS=30
# SEND_ATTEMPT_MAX_ATTEMPTS=5
# SEND_ATTEMPT_LEASE_SECONDS=180
# SEND_ATTEMPT_BASE_BACKOFF_SECONDS=60

# Developer Profile (used by agents)
DEVELOPER_NAME=Your Name
DEVELOPER_SKILLS=Python,FastAPI,React,PostgreSQL,Docker,AI/ML
DEVELOPER_HOURLY_RATE=50
DEVELOPER_BIO=Senior full-stack developer specializing in AI systems and automation.
# Portfolio for Kwork offers (one project per line: name | stack | description or link)
DEVELOPER_PORTFOLIO="JobPilot AI | Python, FastAPI, Celery, LangGraph, Playwright, PostgreSQL, Qdrant, Telegram | AI freelance automation: Kwork scraping, proposal generation, Telegram approval
Corporate web portal | Laravel, Vue 3, Keycloak, PostgreSQL, Redis | internal portal with SSO, roles, REST API (NDA, demo on request)
Order service with personal accounts | Django, React, Celery, Docker | client dashboard, admin, REST API integrations (NDA)
Business Telegram bot | Python, aiogram, FastAPI, PostgreSQL | notifications, dialog flows, external API integration
Data parser and integrations | Python, Playwright, FastAPI, Redis | web scraping, task queues, API export"
DEVELOPER_EXCLUDED_SKILLS=n8n,Make.com,Zapier

# Scraping
SCRAPE_INTERVAL_MINUTES=30
# kwork — supported; generic — configurable HTML; upwork, fl_ru — experimental (selectors/API may break)
ENABLED_SCRAPERS=generic,kwork
GENERIC_SCRAPER_URL=https://example-freelance.com/jobs
# Quote the JSON so dotenv does not strip inner double quotes. Do not export a bare
# {job_card:...} value in your shell — it overrides this file and fails validation.
GENERIC_SCRAPER_SELECTORS='{"job_card":"article.job","title":"h2.title","description":".description","budget":".budget","skills":".skills li","deadline":".deadline","client":".client-name","link":"a.apply"}'

# Kwork (optional credentials)
KWORK_EMAIL=
KWORK_PASSWORD=
KWORK_CATEGORY_URL=https://kwork.ru/projects?fc=11&a=1
KWORK_SKIP_PORTFOLIO_JOBS=true
KWORK_MAX_PAGES=10
KWORK_SCRAPE_LOGIN=false
# Optional: path to Playwright storage state JSON exported after manual Kwork login
KWORK_STORAGE_STATE=
# Bid % below buyer desired budget (default 15 — competitive for new sellers)
KWORK_OFFER_DISCOUNT_PERCENT=15
# Pause Kwork until connects reset (auto-detect date from Kwork UI)
KWORK_PAUSE_ENABLED=true
KWORK_PAUSE_AUTO=true
# Optional bootstrap until first successful Kwork probe:
# KWORK_PAUSE_UNTIL=2026-07-10
KWORK_PAUSE_TIMEZONE=Europe/Moscow
KWORK_PAUSE_CHECK_INTERVAL_HOURS=6
# Poll Kwork inbox for client replies (requires KWORK_EMAIL/KWORK_PASSWORD)
KWORK_INBOX_CHECK_ENABLED=true
KWORK_INBOX_CHECK_INTERVAL_MINUTES=15
MIN_SCORE_THRESHOLD=35

# Scoring weights (JSON, adjusted by LearningAgent)
SCORING_WEIGHTS={"skill_match":0.30,"budget":0.20,"complexity":0.15,"client_quality":0.20,"competition":0.15}

# First reviews: scarce connects, small tasks and proven buyers
REVIEW_FIRST_MODE=true
REVIEW_MAX_HOURS=8
CLIENT_MIN_RATING=4.8
CLIENT_MIN_PAID_ORDERS=1
OLLAMA_SCORING_MODEL=gpt-oss:120b
